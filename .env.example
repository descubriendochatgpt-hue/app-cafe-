# ═══════════════════════════════════════════════════════════════════════════
#  Variables de entorno · copiar a .env.local para desarrollo
#  En Vercel se configuran en Settings → Environment Variables.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública. Va acompañada SIEMPRE de un JWT de usuario: sin él, las
# políticas RLS no dejan leer nada.
SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave de servicio. Se salta RLS entera, así que NUNCA lleva el prefijo
# NEXT_PUBLIC_ y nunca se usa fuera de rutas de servidor. Solo para los
# conectores automáticos y las tareas programadas.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Secreto con el que Supabase firma los JWT (Project Settings → API → JWT).
# El servidor lo usa para firmar la sesión que emite tras comprobar el PIN.
SUPABASE_JWT_SECRET=un-secreto-largo-de-al-menos-32-caracteres

# ── Sesión ────────────────────────────────────────────────────────────────
# Horas que dura la sesión de un operario. En un mercado conviene que sea
# larga: reintroducir el PIN con las manos ocupadas es un engorro.
SESION_HORAS=12

# ── Tareas programadas (Vercel Cron) ──────────────────────────────────────
# Cabecera que protege /api/cron/*. Vercel la envía automáticamente.
CRON_SECRET=otro-secreto-largo

# ── Conectores (fase 3 en adelante; aún sin usar) ─────────────────────────
# LOYVERSE_ACCESS_TOKEN=
# LOYVERSE_WEBHOOK_SECRET=
# WOOCOMMERCE_URL=
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=
# WOOCOMMERCE_WEBHOOK_SECRET=
